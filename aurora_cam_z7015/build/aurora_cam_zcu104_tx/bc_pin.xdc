## generated by make_zcu104_tx.tcl : backchannel input (Z7015 BC_LINK_OK -> link_retrain.bc_rx_up)
## pulled down : no wire = RX down (only used when firmware sets GPIO2[11] = 1)
set_property -dict {PACKAGE_PIN G8 IOSTANDARD LVCMOS33 PULLDOWN TRUE} [get_ports BC_RX_UP]
set_false_path -from [get_ports BC_RX_UP]
