## generated by make_project.tcl
set_property BITSTREAM.GENERAL.COMPRESS TRUE [current_design]
## Z-7015 GTP Quad 112 : Aurora 8B/10B x1 @ 3.125 Gb/s, loopback default = pma
## GT refclk MGTREFCLK0_112 (U9/V9) = 125.000 MHz  <- 보드 회로도와 반드시 확인
set_property PACKAGE_PIN U9 [get_ports GT_REFCLK_clk_p]
set_property PACKAGE_PIN V9 [get_ports GT_REFCLK_clk_n]
create_clock -period 8.000 -name gt_refclk [get_ports GT_REFCLK_clk_p]
## free_clk = IBUFDS_GTE2.ODIV2 (refclk/2) -> BUFG : Aurora init_clk, link_ctrl, VIO, dbg_hub
create_generated_clock -name free_clk -source [get_ports GT_REFCLK_clk_p] -divide_by 2 \
    [get_pins -hier -filter {NAME =~ *u_refclk_ibufds/ODIV2}]

## Aurora lane (x1) -> GTPE2_CHANNEL_X0Y0 (serial pins follow the channel automatically)
##   TXP/N = AA3/AB3  RXP/N = AA7/AB7  (external loopback: TX->RX AC-coupled)
set_property LOC GTPE2_CHANNEL_X0Y0 [get_cells -hier -filter {REF_NAME == GTPE2_CHANNEL}]
