set_property LOC BUFGCTRL_X0Y0 [get_cells aurora_module_i/inst/clock_module_i/clkout0_buf]
set_property LOC BUFGCTRL_X0Y2 [get_cells aurora_module_i/inst/clock_module_i/clkin1_buf]

# Location of IO Primitives which is load of clock spine

# Location of clock ports
set_property LOC IOB_X1Y78 [get_ports DRP_CLK_IN]
set_property LOC IOB_X1Y75 [get_ports INIT_CLK_N]
set_property LOC IOB_X1Y76 [get_ports INIT_CLK_P]

# Clock net "init_clk_i" driven by instance "init_clk_bufg" located at site "BUFGCTRL_X0Y17"
#startgroup
create_pblock {CLKAG_init_clk_i}
add_cells_to_pblock [get_pblocks  {CLKAG_init_clk_i}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="init_clk_i"}]]]
resize_pblock [get_pblocks {CLKAG_init_clk_i}] -add {CLOCKREGION_X1Y0:CLOCKREGION_X1Y0}
#endgroup

# Clock net "drpclk_i" driven by instance "drpclk_bufg" located at site "BUFGCTRL_X0Y16"
