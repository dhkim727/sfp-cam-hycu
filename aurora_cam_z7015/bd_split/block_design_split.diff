 # DESIGN PROCs
 ##################################################################
 
+# [SPLIT] C_GT_LOC_1..4 : 선택한 위치만 1, 나머지 X
+proc _split_gt_loc { n } {
+   if { $n < 1 || $n > 4 } { error "\[split\] C_GT_LOC index must be 1..4 (got $n)" }
+   set l {}
+   for {set i 1} {$i <= 4} {incr i} {
+      lappend l CONFIG.C_GT_LOC_$i [expr {$i == $n ? "1" : "X"}]
+   }
+   return $l
+}
+
+# [SPLIT] IP 가 설정을 받아들였는지와, 아래 연결에 쓰는 핀이 실제로 생겼는지 확인
+proc _split_check_aurora { cell dataflow support loc } {
+   set c [get_bd_cells $cell]
+   foreach {k v} [list Dataflow_Config $dataflow SupportLevel $support C_GT_LOC_$loc 1] {
+      set got [get_property CONFIG.$k $c]
+      if { $got ne $v } { error "\[split\] $cell : CONFIG.$k = '$got' (expected '$v')" }
+   }
+   if { $dataflow eq "TX-only_Simplex" } {
+      set need {tx_system_reset gt_reset power_down loopback init_clk_in drpclk_in
+                drpaddr_in drpen_in drpdi_in drpwe_in tx_aligned tx_verify tx_reset
+                tx_channel_up tx_lane_up tx_hard_err txp txn
+                user_clk_out sync_clk_out pll_not_locked_out sys_reset_out gt_reset_out gt_refclk1_out
+                gt0_pll0outclk_out gt0_pll1outclk_out gt0_pll0outrefclk_out gt0_pll1outrefclk_out
+                gt0_pll0refclklost_out quad1_common_lock_out}
+      set need_if {USER_DATA_S_AXI_TX GT_DIFF_REFCLK1}
+   } else {
+      set need {rx_system_reset gt_reset power_down loopback init_clk_in drpclk_in
+                drpaddr_in drpen_in drpdi_in drpwe_in rx_aligned rx_verify rx_reset
+                rx_channel_up rx_lane_up rx_hard_err soft_err frame_err crc_valid crc_pass_fail_n rxp rxn
+                user_clk sync_clk pll_not_locked gt_refclk1
+                gt0_pll0outclk_in gt0_pll1outclk_in gt0_pll0outrefclk_in gt0_pll1outrefclk_in
+                gt0_pll0refclklost_in quad1_common_lock_in}
+      set need_if {USER_DATA_M_AXI_RX}
+   }
+   set miss {}
+   foreach p $need    { if { [get_bd_pins -quiet $cell/$p] eq "" } { lappend miss $p } }
+   foreach p $need_if { if { [get_bd_intf_pins -quiet $cell/$p] eq "" } { lappend miss $p } }
+   if { [llength $miss] } {
+      set have {}
+      foreach p [get_bd_pins -quiet -of_objects $c] { lappend have [file tail $p] }
+      error "\[split\] $cell : pins not found: $miss\n  available: [lsort $have]"
+   }
+   common::send_gid_msg -ssname BD::TCL -id 2005 -severity "INFO" "\[split\] $cell : $dataflow, SupportLevel $support, GTPE2_CHANNEL_X0Y[expr {$loc - 1}]"
+}
+
+# [SPLIT] TX/RX 짝은 프레이밍/CRC/엔디안/레이트가 같아야 한다 (CRC 가 한쪽만 켜지면 프레임 길이가 어긋남)
+proc _split_check_pair { tx rx } {
+   foreach k {C_LINE_RATE C_REFCLK_FREQUENCY C_LANE_WIDTH Interface_Mode C_USE_CRC C_USE_BYTESWAP C_USE_SCRAMBLER Backchannel_mode} {
+      set a [get_property CONFIG.$k [get_bd_cells $tx]]
+      set b [get_property CONFIG.$k [get_bd_cells $rx]]
+      if { $a ne $b } { error "\[split\] CONFIG.$k differs : $tx = '$a', $rx = '$b'" }
+   }
+}
 
 
